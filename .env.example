# Copy to .env.local (git-ignored). Never commit real values.

# --- paths ---
LEADSCORE_DATA_RAW=data/raw/Leads.csv
LEADSCORE_MODEL_PATH=models/model.joblib
LEADSCORE_DB_PATH=data/predictions.db

# --- training ---
LEADSCORE_RANDOM_SEED=42
LEADSCORE_TEST_SIZE=0.2
LEADSCORE_CV_FOLDS=5
LEADSCORE_OPTUNA_TRIALS=40
# fail `make train` if the new model is worse than this on the test set
LEADSCORE_GATE_MIN_ROC_AUC=0.80
LEADSCORE_GATE_MAX_BRIER=0.18

# --- api ---
LEADSCORE_API_HOST=0.0.0.0
LEADSCORE_API_PORT=8000
LEADSCORE_MAX_BATCH=1000
LEADSCORE_LOG_LEVEL=INFO
# optional shared-secret header for write endpoints; empty = open (local only)
LEADSCORE_API_KEY=

# --- dashboard ---
LEADSCORE_API_BASE_URL=http://localhost:8000

# --- mlflow (local sqlite; the file store was retired in mlflow 3.18) ---
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# --- kaggle download (CI only; store as GitHub secrets, never here) ---
KAGGLE_USERNAME=
KAGGLE_KEY=
